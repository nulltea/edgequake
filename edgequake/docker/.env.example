# EdgeQuake Docker environment configuration
# Copy this file to .env and fill in the values you need.
# Used by both docker-compose.yml (full stack) and docker-compose.api-only.yml.

# ── Database ─────────────────────────────────────────────────────────────────
# Required for api-only mode. In full-stack mode this is pre-set by compose.
# DATABASE_URL=postgres://edgequake:edgequake_secret@localhost:5432/edgequake

# PostgreSQL password (full-stack mode only)
# POSTGRES_PASSWORD=edgequake_secret

# ── Ports ─────────────────────────────────────────────────────────────────────
# EDGEQUAKE_PORT=8080
# FRONTEND_PORT=3000
# POSTGRES_PORT=5432

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose one: openai | anthropic | gemini | mistral | azure | vertexai | xai | ollama | lmstudio | mock
EDGEQUAKE_LLM_PROVIDER=ollama

# Optional: use a different provider for embeddings (hybrid mode)
# EDGEQUAKE_EMBEDDING_PROVIDER=ollama

# ── Provider API Keys ─────────────────────────────────────────────────────────
# Set the key(s) for the provider(s) you use.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
# MISTRAL_API_KEY=...
# XAI_API_KEY=xai-...

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com

# ── Google Vertex AI ──────────────────────────────────────────────────────────
# GOOGLE_CLOUD_PROJECT=my-gcp-project
# GOOGLE_ACCESS_TOKEN=ya29....    # or configure Application Default Credentials

# ── Ollama ────────────────────────────────────────────────────────────────────
# When running inside Docker, host.docker.internal reaches the host machine.
OLLAMA_HOST=http://host.docker.internal:11434

# ── Embedding overrides ───────────────────────────────────────────────────────
# EDGEQUAKE_EMBEDDING_MODEL=text-embedding-3-small
# EDGEQUAKE_EMBEDDING_DIMENSION=1536
# OLLAMA_EMBEDDING_HOST=http://gpu-box:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── Logging ───────────────────────────────────────────────────────────────────
RUST_LOG=info

# ── Reference Code GraphRAG — Phase 1 (code-analyzer sidecar) ────────────────
# Required if you want the code-analyzer to actually analyze anything.
# One-time setup: run `claude setup-token` on a host with a browser, paste the
# resulting 1-year sk-ant-oat01-... token below. The service uses your Claude
# Code subscription — do NOT also set ANTHROPIC_API_KEY (it would override
# and bill against API credits instead of your subscription).
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# CODE_ANALYZER_PORT=9100
# CODE_ANALYZER_LOG_LEVEL=INFO

# ── Reference Code GraphRAG — Phase 0 (GitHub Search for repo discovery) ─────
# Layer B uses the GitHub Search API to find the paper's reference repo.
# Unauthenticated mode is 60 req/hr (fine for dev, throttles in production).
# Generate a PAT at https://github.com/settings/tokens (classic) — only the
# `public_repo` scope is needed (or no scope for fine-grained tokens).
# GITHUB_TOKEN=ghp_...
